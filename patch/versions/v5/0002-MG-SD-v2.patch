From: sunchendd <sunchendong@kunlunit.com>
Date: Thu, 21 May 2026 05:01:55 +0000
Subject: [PATCH 2/3] MG-SD v2

---
 v1/sample/rejection_sampler.py | 43 ++++++++++++++++++++++++++++------
 1 file changed, 36 insertions(+), 7 deletions(-)

diff --git a/v1/sample/rejection_sampler.py b/v1/sample/rejection_sampler.py
index 93a65db..396f309 100644
--- a/v1/sample/rejection_sampler.py
+++ b/v1/sample/rejection_sampler.py
@@ -3,6 +3,7 @@
 
 from __future__ import annotations
 
+import math
 import os
 from collections.abc import Sequence
 from dataclasses import replace
@@ -28,15 +29,38 @@ if TYPE_CHECKING:
 
 logger = init_logger(__name__)
 
-EARS_BASE_TOLERANCE = float(os.environ.get("VLLM_EARS_BASE_TOLERANCE", "0.0"))
+def _parse_float_env(name: str, default: str) -> float:
+    raw_value = os.environ.get(name, default)
+    try:
+        parsed_value = float(raw_value)
+    except ValueError:
+        logger.warning(
+            "Invalid %s=%r, falling back to %s",
+            name,
+            raw_value,
+            default,
+        )
+        return float(default)
+    if not math.isfinite(parsed_value):
+        logger.warning(
+            "Non-finite %s=%r, falling back to %s",
+            name,
+            raw_value,
+            default,
+        )
+        return float(default)
+    return parsed_value
+
+
+EARS_BASE_TOLERANCE = _parse_float_env("VLLM_EARS_BASE_TOLERANCE", "0.0")
 MGSD_ENABLED = os.environ.get("VLLM_MGSD_ENABLED", "0").lower() in (
     "1",
     "true",
     "yes",
 )
-MGSD_MARGIN_DELTA = float(os.environ.get("VLLM_MGSD_MARGIN_DELTA", "0.0"))
+MGSD_MARGIN_DELTA = _parse_float_env("VLLM_MGSD_MARGIN_DELTA", "0.0")
 if EARS_BASE_TOLERANCE > 0:
-    if MGSD_ENABLED and MGSD_MARGIN_DELTA > 0:
+    if MGSD_ENABLED:
         logger.info(
             "MG-SD enabled with base_tolerance=%.3f margin_delta=%.3f",
             EARS_BASE_TOLERANCE,
@@ -491,11 +515,16 @@ def rejection_sample(
     max_target_probs = None
     target_margins = None
     ears_enabled = EARS_BASE_TOLERANCE > 0
-    mgsd_enabled = ears_enabled and MGSD_ENABLED and MGSD_MARGIN_DELTA > 0
+    mgsd_enabled = ears_enabled and MGSD_ENABLED
     if ears_enabled:
-        target_top2_probs = target_probs.topk(k=2, dim=-1).values
-        max_target_probs = target_top2_probs[:, 0]
-        target_margins = target_top2_probs[:, 0] - target_top2_probs[:, 1]
+        if mgsd_enabled:
+            target_top2_probs = target_probs.topk(k=2, dim=-1).values
+            max_target_probs = target_top2_probs[:, 0].contiguous()
+            target_margins = (
+                target_top2_probs[:, 0] - target_top2_probs[:, 1]
+            ).contiguous()
+        else:
+            max_target_probs = target_probs.max(dim=-1).values.contiguous()
 
     # Sample recovered tokens for each position.
     # [num_tokens]
-- 
