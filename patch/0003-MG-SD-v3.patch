index 396f309..7cc4770 100644
--- a/v1/sample/rejection_sampler.py
+++ b/v1/sample/rejection_sampler.py
@@ -525,6 +525,11 @@ def rejection_sample(
             ).contiguous()
         else:
             max_target_probs = target_probs.max(dim=-1).values.contiguous()
